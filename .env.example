# Copy to .env.local; never commit actual values.
TREVIX_SITE_URL=https://trevix.digital
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No global NEXT_PUBLIC_BASE_PATH: /mundialito is an actual route.
OFFICIAL_ROSTERS_DIR=
OFFICIAL_IMPORT_RUNS_DIR=
SUPABASE_PHASE4_READ_ENABLED=false
SUPABASE_PHASE4_CARD_WRITES_ENABLED=false
SUPABASE_PHASE4_CERTIFICATION_WRITES_ENABLED=false
SUPABASE_PHASE4_WRITE_TARGET=
SUPABASE_PHASE4_ISOLATED_URL=
SUPABASE_PHASE4_PRODUCTION_CARD_WRITES_APPROVED=false
SUPABASE_CLASSIFICATION_WRITES_ENABLED=false
SUPABASE_CLASSIFICATION_PRODUCTION_WRITES_APPROVED=false
SUPABASE_CARD_REGISTRATION_READ_ENABLED=false
SUPABASE_CARD_REGISTRATION_WRITES_ENABLED=false
SUPABASE_KNOCKOUT_PROGRESS_ENABLED=false
SUPABASE_KNOCKOUT_PRODUCTION_WRITES_APPROVED=false
DEV_ALLOWED_ORIGINS=
# Node hosting entry point; bind only the one Next.js process.
HOSTNAME=127.0.0.1
PORT=3300
